[Unit]
Description=Browser Live Independent Agent
After=graphical-session.target network-online.target
[Service]
Type=simple
WorkingDirectory=/home/leo/Aplicativos/browser-live-independent
ExecStart=/home/leo/Aplicativos/browser-live-independent/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8918 --no-access-log
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/leo/.Xauthority
Environment=ANONYMIZED_TELEMETRY=false
Environment=BROWSER_USE_LOGGING_LEVEL=error
Environment=BROWSER_USE_CLOUD_SYNC=false
UMask=0077
# Initial safeguards for the 8 GiB notebook. Tune with PSI/cgroup measurements.
# MemoryHigh throttles; MemoryMax can trigger cgroup OOM under sustained pressure.
MemoryAccounting=yes
MemoryHigh=3500M
MemoryMax=4500M
MemorySwapMax=512M
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
[Install]
WantedBy=default.target
